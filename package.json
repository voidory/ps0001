{
  "name": "ps0001",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Repository command shortcuts; the canonical LoopLab application is in looplab/.",
  "scripts": {
    "setup": "npm ci --prefix looplab",
    "catalogue": "npm --prefix looplab run catalogue",
    "dev": "npm --prefix looplab run dev",
    "typecheck": "npm --prefix looplab run typecheck",
    "lint": "npm --prefix looplab run lint",
    "test": "npm --prefix looplab run test",
    "test:python": "npm --prefix looplab run test:python",
    "test:e2e": "npm --prefix looplab run test:e2e",
    "build": "npm --prefix looplab run build",
    "preview": "npm --prefix looplab run preview"
  }
}
