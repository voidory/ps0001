{
  "name": "looplab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "catalogue": "python3 scripts/build_catalogue.py",
    "dev": "npm run catalogue && vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests *.ts",
    "test": "vitest run",
    "test:python": "python3 -m unittest discover -s scripts -p 'test_*.py' -v",
    "test:e2e": "playwright test",
    "build": "npm run catalogue && npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "idb": "^8.0.3",
    "katex": "^0.16.25",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "^6.2.4",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vitest": "^4.0.9"
  }
}
