+
+/* Mathematical fonts retain KaTeX metrics. Never override .katex with the UI or code font. */
+.math-inline{white-space:nowrap}
+.math-inline .katex{font-size:1.08em;line-height:normal}
+.math-block{display:block;max-width:100%;overflow-x:auto;padding-block:var(--space-3);margin-block:var(--space-2)}
+.math-block .katex-display{margin:0;text-align:left}
+.formula>.math-block{margin:0;padding-block:var(--space-2)}
+.question-prompt{line-height:1.9;overflow-wrap:break-word}
+.math-error{color:var(--error);font-family:var(--font-body);white-space:normal}
+code,pre,textarea,.exact{font-variant-ligatures:none;font-feature-settings:"liga" 0,"calt" 0;letter-spacing:0}
+pre code{white-space:pre;overflow-wrap:normal;word-break:normal}
+textarea{line-height:1.7;tab-size:4}
+.answer-row input,input[inputmode="numeric"],td{font-family:var(--font-code);font-variant-numeric:tabular-nums slashed-zero}
+
+.equation-help{display:block;font-size:var(--text-xs);color:var(--muted);margin-top:var(--space-2)}
+@media(min-width:701px){.equation-help{display:none}}
